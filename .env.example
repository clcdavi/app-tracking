# Configuración de Base de Datos PostgreSQL
DB_USER=enfoco
DB_PASSWORD=reemplazar_con_password_muy_seguro_123
DB_NAME=enfoco_db

# Límite máximo de conexiones en el pool (opcional, por defecto 10)
DB_POOL_MAX=10

# Puerto en el que se expondrá la aplicación en la máquina anfitriona (VPS)
APP_PORT=3000

# Forzar cookies sólo por HTTPS (false para http://IP:3000, true para dominio con SSL/HTTPS)
COOKIE_SECURE=false

# Permitir creación de cuentas (true al iniciar para crear tu cuenta, luego false para uso estrictamente privado)
ALLOW_REGISTRATION=true

# Zona horaria del servidor (para alertas y timeboxing)
TZ=America/Argentina/Buenos_Aires

# Bot de Telegram (Opcional pero muy recomendado - obtener desde @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_BOT_USERNAME=MiEnfocoAppBot

# Google Gemini AI (Opcional - para notas de voz en Telegram y desglose inteligente de tareas)
# Obtené tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.5-flash-lite
