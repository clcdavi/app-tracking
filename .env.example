# Configuración de Base de Datos PostgreSQL
DB_USER=enfoco
DB_PASSWORD=reemplazar_con_password_muy_seguro_123
DB_NAME=enfoco_db

# Puerto en el que se expondrá la aplicación en la máquina anfitriona (VPS)
APP_PORT=3000

# Permitir creación de cuentas (true al iniciar para crear tu cuenta, luego podés cambiarlo a false para uso estrictamente privado)
ALLOW_REGISTRATION=true

# Zona horaria del servidor
TZ=America/Argentina/Buenos_Aires
